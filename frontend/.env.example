# Copy to .env and fill in.

VITE_API_BASE_URL=http://localhost:8000

# Firebase web config — from Firebase console > Project settings > Your apps.
# Safe to expose in a frontend bundle (it's public config, not a secret).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=demo-voxmind
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Point the client Auth SDK at the local emulator during development.
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
