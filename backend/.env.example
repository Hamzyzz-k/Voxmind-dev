# Copy to .env and fill in. Never commit the real .env file.

ENV=development

# --- Firebase / Firestore ---
# For local dev with the emulator suite, use a "demo-" prefixed project id
# (e.g. demo-voxmind) — no real GCP project needed until you deploy.
FIREBASE_PROJECT_ID=demo-voxmind
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# Leave unset locally (uses `gcloud auth application-default login`). In
# production on Cloud Run, leave unset too — the attached service account is
# used automatically.
GOOGLE_APPLICATION_CREDENTIALS=

# --- CORS ---
# Comma-separated. Add your Firebase Hosting URL once deployed.
ALLOWED_ORIGINS=http://localhost:5173

# --- LLM ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_CONCURRENCY=5
GROQ_MAX_RETRIES=3
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- TTS (ElevenLabs — no GCP billing account needed) ---
# If this is empty or ElevenLabs errors/runs out of credits, /chat/ask returns
# audio_base64=null + audio_error, and the frontend automatically falls back
# to the browser's own speechSynthesis voice. No server-side TTS fallback.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL_ID=eleven_v3

# --- Chat / memory ---
CHAT_HISTORY_LIMIT=20

# --- OTP / MFA ---
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
MFA_SESSION_TTL_SECONDS=43200

# --- OTP email delivery ---
# Preferred: Brevo's HTTP API. Render's free web services block outbound SMTP
# ports (25/465/587), so SMTP cannot leave the container there at all.
# Get the key from Brevo > SMTP & API > API Keys.
BREVO_API_KEY=
# SMTP_FROM is the verified sender address and is required by BOTH transports.
# The SMTP_* values below are only used as a local-dev fallback.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Audio upload limits ---
MAX_AUDIO_UPLOAD_BYTES=10485760
ALLOWED_AUDIO_CONTENT_TYPES=audio/wav,audio/webm,audio/ogg,audio/mpeg

# --- IoT (Phase 2) ---
# Signs short-lived tickets so a browser can poll video frames without a
# Firestore read per request. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, POST /iot/camera/{id}/ticket returns 503 rather than silently
# skipping the signature.
STREAM_TICKET_SECRET=

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=30/minute
RATE_LIMIT_CHAT=10/minute
RATE_LIMIT_OTP=5/minute
RATE_LIMIT_DEVICE=600/minute
RATE_LIMIT_STREAM_POLL=600/minute
