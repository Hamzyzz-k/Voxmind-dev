# Copy to .env and fill in. Never commit the real .env file.

ENV=development

# --- Firebase / Firestore ---
# For local dev with the emulator suite, use a "demo-" prefixed project id
# (e.g. demo-voxmind) — no real GCP project needed until you deploy.
FIREBASE_PROJECT_ID=demo-voxmind
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# Leave unset locally (uses `gcloud auth application-default login`). In
# production on Cloud Run, leave unset too — the attached service account is
# used automatically.
GOOGLE_APPLICATION_CREDENTIALS=

# --- CORS ---
# Comma-separated. Add your Firebase Hosting URL once deployed.
ALLOWED_ORIGINS=http://localhost:5173

# --- LLM ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_CONCURRENCY=5
GROQ_MAX_RETRIES=3
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- TTS (ElevenLabs — no GCP billing account needed) ---
# If this is empty or ElevenLabs errors/runs out of credits, /chat/ask returns
# audio_base64=null + audio_error, and the frontend automatically falls back
# to the browser's own speechSynthesis voice. No server-side TTS fallback.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL_ID=eleven_v3

# --- Chat / memory ---
CHAT_HISTORY_LIMIT=20

# --- OTP / MFA ---
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
MFA_SESSION_TTL_SECONDS=43200

# --- SMTP (OTP email delivery) ---
# Until these are filled in, /auth/otp/request returns an honest 503 instead
# of pretending to send an email. See ACCOUNT_SETUP.md for free providers.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Audio upload limits ---
MAX_AUDIO_UPLOAD_BYTES=10485760
ALLOWED_AUDIO_CONTENT_TYPES=audio/wav,audio/webm,audio/ogg,audio/mpeg

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=30/minute
RATE_LIMIT_CHAT=10/minute
RATE_LIMIT_OTP=5/minute
